---
import Layout from "../layouts/Layout.astro";
const base = import.meta.env.BASE_URL;
---

<Layout uid="index">
  <div class="content home">
    <div class="galaxy-wrap" aria-hidden="true">
      <div class="galaxy-container" id="galaxy"></div>
    </div>

    <div class="home__inner">
      <p class="home__eyebrow">AI Consultant · Co-Founder @ AutoAny</p>
      <h1
        class="title home__title"
        data-motion-text="true"
        data-motion-text-split="chars"
        data-motion-text-duration="0.5"
      >
        Haris Wassan
      </h1>
      <p class="home__lede">
        Production AI systems for operations-heavy businesses.
      </p>
      <div class="home__actions">
        <a class="home__cta" href={`${base}works/index.html`}>View work</a>
        <a class="home__cta home__cta--ghost" href={`${base}contact/index.html`}
          >Contact</a
        >
      </div>
    </div>
  </div>
</Layout>
